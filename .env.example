# ===================================================================
# eCourts Case Tracker & WhatsApp Dispatcher Environment Configuration
# ===================================================================

# 1. Official eCourts Partner API Key (https://webapi.ecourtsindia.com)
ECOURTS_API_KEY=eci_live_your_api_key_here
ECOURTS_API_BASE_URL=https://webapi.ecourtsindia.com/api/partner

# 2. Meta WhatsApp Business Cloud API (Official Cloud API)
META_WA_TOKEN=your_meta_system_user_access_token_here
META_PHONE_ID=your_meta_phone_number_id_here
META_WABA_ID=your_whatsapp_business_account_id_here
META_GRAPH_API_VERSION=v21.0

# 3. Application & Server Settings
FLASK_ENV=production
SECRET_KEY=generate_a_secure_random_key_here
PORT=5000

# 4. Background Sync & Keep-Alive Settings
SYNC_INTERVAL_SECONDS=3600
KEEP_ALIVE_ENABLED=true
RENDER_EXTERNAL_URL=https://ecourts-case-tracker.onrender.com
